# Build artifacts
build/
managed_components/

# SDK config backups + per-target snapshots
sdkconfig.old
sdkconfig.bak
sdkconfig.esp32
sdkconfig.esp32s3
sdkconfig.esp32s3.latest

# Auto-generated by the CMakeLists board/SR/flash-size partition picker;
# the source-of-truth files are partitions_{sr,no_sr}_{8mb,16mb}.csv.
partitions.csv

# Ad-hoc dev outputs (bitmap conversion tests, size reports)
output*.bmp
size.json
sizefiles.txt

# Raw data pulled off hardware during testing. Never publish: the health
# captures are real biometric readings (heart rate / SpO2) and the device
# logs carry usernames, command history and network detail.
docs/HealthCapture/
docs/NewCapture/

# Ad-hoc per-board firmware build outputs copied to the repo root for flashing
# (e.g. hardwareone-idf-gamepad-step2.bin). Build products, not source.
*.elf
*.bin

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Claude Code worktrees (isolated repo copies)
.claude/

# Nested git repos (have their own repos)
components/hardwareone/icons/
components/arduino/

# Vendored upstream / reverse-engineering reference trees (not first-party)
# A Dark Room game source (MPL-2.0); bundler re-clones at pinned commit if absent.
third_party/adarkroom/
docs/FlutterApp-main/
docs/evenrealities_rev_share-main/
docs/even-g2-notes-main/
docs/even-g2-protocol-main/
