# Build artifacts
build/
# Per-board isolated build dirs (tools/build_board.sh): build-<board>/,
# each with its own sdkconfig — see docs/BOARD_SWITCHING.md.
build-*/
managed_components/

# Local scratch: third-party APKs, slide drafts, and other working material
# that must never be published from this repo.
.scratch/

# SDK config backups + per-target snapshots
sdkconfig.old
sdkconfig.bak
sdkconfig.esp32
sdkconfig.esp32s3
sdkconfig.esp32s3.latest

# Auto-generated by the CMakeLists board/SR/flash-size partition picker;
# the source-of-truth files are partitions_{sr,no_sr}_{8mb,16mb}.csv.
partitions.csv

# Ad-hoc dev outputs (bitmap conversion tests, size reports)
output*.bmp
size.json
sizefiles.txt

# Raw data pulled off hardware during testing. Never publish: the health
# captures are real biometric readings (heart rate / SpO2) and the device
# logs carry usernames, command history and network detail.
docs/HealthCapture/
docs/NewCapture/

# Ad-hoc per-board firmware build outputs copied to the repo root for flashing
# (e.g. hardwareone-idf-gamepad-step2.bin). Build products, not source.
*.elf
*.bin

# OTA signing material and isolated OTA sdkconfig.  The private key must never
# enter version control; OTA builds use this conventional local filename unless
# HW1_OTA_SIGNING_KEY points at a key kept elsewhere.
# Private keys, by extension rather than by one exact filename.
#
# This used to list only "ota_signing_key.pem", which protects exactly one
# name. A production key copied in under any other name -- hw1-ota-prod.pem,
# say -- showed up as an ordinary untracked file that `git add -A` would
# happily stage. An OTA signing key is the trust root for devices that cannot
# be recovered over a cable; committing one is not a recoverable mistake.
*.pem
*.pem.pub
*.key
sdkconfig.ota
sdkconfig.updater
build-ota/
updater/build/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Claude Code worktrees (isolated repo copies)
.claude/

# Nested git repos (have their own repos)
components/hardwareone/icons/
components/arduino/

# Vendored upstream / reverse-engineering reference trees (not first-party)
# A Dark Room game source (MPL-2.0); bundler re-clones at pinned commit if absent.
third_party/adarkroom/
docs/FlutterApp-main/
docs/evenrealities_rev_share-main/
docs/even-g2-notes-main/
docs/even-g2-protocol-main/

# Private firmware documentation (docs2/): generated from source, never published.
docs2/

# Scratch/render output — large binaries (CAD, datasheets, PNG renders).
# Kept local: git never forgets a 77 MB blob.
output/
tmp/

# screen(1) session log — captured locally, never part of the source
screenlog.*
