# ESP32-S3 family build configuration — common to ALL ESP32-S3 boards.
# Loaded automatically by ESP-IDF when target is esp32s3 (idf.py set-target esp32s3).
# Do not delete. Controls PSRAM presence/speed, flash mode, Bluetooth, USB.
#
# BOARD-SPECIFIC settings (CONFIG_ARDUINO_VARIANT, CONFIG_SPIRAM_MODE_*) are
# NOT here — they live in boards/<name>.defaults and get layered on top via
# the HW_BOARD selection logic in CMakeLists.txt. To switch boards:
#   HW_BOARD=feathers3 idf.py fullclean && HW_BOARD=feathers3 idf.py build
# (default HW_BOARD is xiao_s3.) See docs/BOARD_SWITCHING.md for the full guide.
#
# If you are switching from ESP32 back to ESP32-S3, run `idf.py fullclean`
# before building so the proper esp32s3 defaults are re-applied cleanly.

# PSRAM presence + speed (mode is board-specific — see boards/<name>.defaults).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y

# Data-cache line size: 64 B (the S3 hardware maximum) instead of the 32 B
# default. For sequential streaming — notably on-device LLM weight reads, which
# are PSRAM-bandwidth bound — this halves the number of slow PSRAM fetch
# round-trips (one bus setup per 64 B instead of per 32 B). Free: line size only
# re-slices the fixed data cache, so it costs no RAM. Cache *size* is left at
# 32 KB on purpose — bumping to 64 KB would steal ~32 KB of scarce internal
# DRAM and wouldn't help a stream-once / never-reuse workload.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Flash mode - S3 can use QIO
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Bluetooth disabled on ESP32-S3 — frees ~14 KB IRAM, ~70 KB flash, ~80 KB
# DRAM bss/data. Mirrored in:
#   - sdkconfig.defaults                  (CONFIG_BT_ENABLED=n)
#   - components/hardwareone/System_BuildConfig.h   (ENABLE_BLUETOOTH 0
#                                                    + ENABLE_G2_GLASSES 0)
# All three must be flipped together to re-enable. After flipping:
#   idf.py fullclean && idf.py set-target esp32s3 && idf.py build
# When BT is on, the original lines were:
#   CONFIG_BT_ENABLED=y
#   CONFIG_BT_BLUEDROID_ENABLED=y
#   CONFIG_BT_CONTROLLER_ENABLED=y
#   CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y      # for Arduino BLE legacy adv
# Re-enabled 2026-06-06 for G2 glasses / BLE (see System_BuildConfig.h flags).
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# USB - Native USB on S3. Serial uses HWCDC (CONFIG_ARDUINO_USB_MODE=1 =
# hardware USB-Serial/JTAG), not TinyUSB — so CONFIG_TINYUSB_CDC_ENABLED was a
# no-op and is gone in IDF 5.5 (it produced an "unknown kconfig symbol" warning).

# XIAO Sense expansion board features (camera, mic, SD)
# Add to compiler defines
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# UART host link (docs/UART_HOST_LINK_PLAN.md): the IDF console moves to
# USB-Serial-JTAG so UART0 (GPIO43/44) is app-owned for the CM5 link.
# Panic/log output was ALREADY mirrored to USB (secondary console) before
# this change; the only observable delta is UART0 going quiet.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
