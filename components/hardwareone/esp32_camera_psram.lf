# The managed esp32-camera component is regenerated by IDF and is intentionally
# git-ignored. Keep this project-specific placement outside the vendored source:
# the JPEG decoder's fixed 3,100-byte `work` array is ordinary CPU scratch used
# from task context, so it does not need scarce internal DRAM.

[scheme:hw1_camera_decoder_ext_bss]
entries:
    bss -> extern_ram
    common -> extern_ram

[mapping:hw1_camera_decoder_work]
archive: libespressif__esp32-camera.a
entries:
    if ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY = y:
        to_bmp:work (hw1_camera_decoder_ext_bss)
