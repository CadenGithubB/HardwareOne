# Pocket Assistant sdkconfig overlay — Seeed XIAO ESP32-S3.
#
# Layered after the shared and board software presets for the main application.
# The recovery updater is a separate project with its own radio configuration.
#
# This release requires Bluetooth for G2 glasses and the R1 ring. Pin the SDK
# stack here so future changes to the ordinary software presets cannot remove
# those capabilities. The current shared preset already enables Bluetooth;
# the other keys match the S3 backend defaults and document the release contract.
# Application flags alone cannot provide these SDK dependencies: the derived
# rules disable Bluetooth/G2/R1 if the active sdkconfig lacks Bluedroid.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
