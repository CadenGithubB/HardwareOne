 uint8_t is_transport_tx_ready(void)
 {
 	return (transport_state >= TRANSPORT_TX_ACTIVE);
+}
+
+/* HardwareOne: a one-way TX fence for an intentional host restart. Once it is
+ * set, esp_hosted_tx and the STA/AP/serial wrappers refuse every new packet,
+ * and the write task only sends what was already queued. transport_state is
+ * left alone, so transport_drv_reconfigure() (Wi-Fi init, BLE open) still sees
+ * an up transport and starts no slave reset or card init. Only a CPU reset
+ * clears it.
+ *
+ * A refusal at the fence is counted, never logged: the producer's own task
+ * pays for the log, and Bluedroid's hciT (2.5 KB stack) overflowed in vfprintf
+ * printing esp_hosted_tx's "tx fail" line for each HCI packet its live links
+ * sent during the restart (bench 2026-11-08, 3 of 15 reboots).
+ *
+ * An HCI packet is also dropped without a log whenever TX is not open for
+ * any other reason (C6 crash or reset, a companion hold or re-init while the
+ * Bluedroid host is still up): it is sent from the same hciT task, and the
+ * same two log lines would overflow it. Those drops have their own count.
+ */
+static volatile uint8_t hw1_tx_fenced = 0;
+static uint32_t hw1_tx_fence_drops = 0;
+static uint32_t hw1_tx_hci_down_drops = 0;
+
+void esp_hosted_hw1_fence_tx(void)
+{
+	hw1_tx_fenced = 1;
+}
+
+uint8_t esp_hosted_hw1_tx_open(void)
+{
+	return is_transport_tx_ready() && !hw1_tx_fenced;
+}
+
+uint8_t esp_hosted_hw1_tx_fenced(void)
+{
+	return hw1_tx_fenced;
+}
+
+uint8_t esp_hosted_hw1_tx_drop_if_fenced(void)
+{
+	if (!hw1_tx_fenced)
+		return 0;
+	__atomic_fetch_add(&hw1_tx_fence_drops, 1, __ATOMIC_RELAXED);
+	return 1;
+}
+
+uint32_t esp_hosted_hw1_tx_fence_drops(void)
+{
+	return __atomic_load_n(&hw1_tx_fence_drops, __ATOMIC_RELAXED);
+}
+
+uint8_t esp_hosted_hw1_hci_drop_if_closed(void)
+{
+	if (esp_hosted_hw1_tx_drop_if_fenced())
+		return 1;
+	if (is_transport_tx_ready())
+		return 0;
+	__atomic_fetch_add(&hw1_tx_hci_down_drops, 1, __ATOMIC_RELAXED);
+	return 1;
 }
 
+uint32_t esp_hosted_hw1_hci_down_drops(void)
+{
+	return __atomic_load_n(&hw1_tx_hci_down_drops, __ATOMIC_RELAXED);
+}
