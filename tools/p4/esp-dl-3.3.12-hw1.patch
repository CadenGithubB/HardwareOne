+#pragma once
+/**
+ * HardwareOne tree-local addition: where ESP-DL keeps a model's long-lived metadata.
+ *
+ * A dl::Model keeps, for as long as it lives, a few thousand small blocks besides its weights and
+ * its activation arena: the Model, ModelContext, FbsLoader and FbsModel objects, one object per
+ * module, one TensorBase per tensor with its shape/axis_offset vectors and per-channel exponent
+ * array, the modules' input/output index vectors and Conv attributes, the context's tensor lists
+ * and execution plan, and the tensor-name map with its key strings. Upstream allocates the
+ * containers and the Model/context/loader objects with plain new (std::allocator), which the
+ * ESP-IDF heap serves from internal RAM below CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL, and the module,
+ * tensor and exponent blocks with malloc_aligned(MALLOC_CAP_DEFAULT).
+ *
+ * Every one of those allocation sites now asks metadata_alloc() for its block, naming what it is
+ * (MetadataKind) and the alignment it needs, and returns it with metadata_free(). The application
+ * decides where the blocks go by installing a MetadataAllocator once (HardwareOne: a PSRAM
+ * request through ps_alloc). Nothing else changes: no global malloc hook, no heap threshold
+ * change, and allocations ESP-DL makes for a single inference (kernel arguments, shift tables)
+ * keep their own allocators. With no allocator installed every site behaves exactly as upstream.
+ *
+ * Contract for an installed allocator:
+ *  - alloc(size, align, kind): size > 0, align a power of two (at most 16); returns a block of
+ *    at least size bytes aligned to align, or nullptr. Called from tasks only (never from an
+ *    ISR or with the cache disabled; no ESP-DL code runs there).
+ *  - free(ptr): accepts nullptr and any block of the ESP-IDF heap, not only its own. Prebuilt
+ *    code (libfbs_model, ESP-SR) allocates some of the same objects with malloc_aligned or global
+ *    new, and this tree's operator delete / deallocate return them here. On ESP-IDF free() and
+ *    heap_caps_free() accept any heap block, aligned or not.
+ *  - The allocator object must have static storage duration. It may be installed (or replaced)
+ *    while models exist: every free function accepts every heap block, so a block allocated
+ *    before the switch is still freed correctly after it.
+ */
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <limits>
+#include <map>
+#include <new>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+namespace dl {
+namespace tool {
+
+/** What a metadata block holds; the installed allocator may route or count by it. */
+enum class MetadataKind : uint8_t {
+    Model = 0, ///< dl::Model objects (class operator new)
+    Context,   ///< dl::ModelContext objects
+    Loader,    ///< fbs::FbsLoader objects
+    Fbs,       ///< fbs::FbsModel objects created by this tree's loader
+    Module,    ///< module objects (Conv, Add, LUT, ...)
+    Tensor,    ///< TensorBase objects created by this tree's code
+    Exponent,  ///< per-channel exponent arrays (ExponentInfo)
+    Shape,     ///< TensorBase::shape / axis_offset storage
+    Index,     ///< module input/output index vectors, Conv pads/strides/dilations
+    List,      ///< ModelContext tensor lists, the execution plan
+    Names,     ///< ModelContext tensor-name map nodes and key strings
+    Count
+};
+constexpr size_t kMetadataKinds = static_cast<size_t>(MetadataKind::Count);
+
+/** Short lower-case name of a kind ("model", "ctx", ...), "?" for an invalid value. */
+const char *metadata_kind_name(MetadataKind kind);
+
+struct MetadataAllocator {
+    void *(*alloc)(size_t size, size_t align, MetadataKind kind);
+    void (*free)(void *ptr);
+};
+
+/** Install the allocator every metadata site uses (nullptr: the upstream placement). */
+void set_metadata_allocator(const MetadataAllocator *allocator);
+const MetadataAllocator *get_metadata_allocator();
+
+/** A block for metadata of this kind, or nullptr. size 0 is served as 1 byte. */
+void *metadata_alloc(size_t size, size_t align, MetadataKind kind);
+/** Return a block (nullptr allowed; any heap block accepted). */
+void metadata_free(void *ptr);
+/** Out of memory in a context that cannot return nullptr (throwing new, containers): aborts
+ *  (throws std::bad_alloc when exceptions are enabled), like ::operator new. */
+[[noreturn]] void metadata_bad_alloc(size_t size, MetadataKind kind);
+
+/**
+ * Objects a model keeps that prebuilt code allocated, so no metadata site placed them: the
+ * parameter TensorBase objects fbs::FbsModel creates (libfbs_model.a, malloc_aligned with
+ * MALLOC_CAP_DEFAULT). Model::load reports each one; the counters say how many there were and
+ * how many of them are in internal RAM.
+ */
+void metadata_note_foreign(const void *object);
+struct MetadataForeignStats {
+    uint32_t objects;  ///< reported objects
+    uint32_t internal; ///< of those, objects not in external RAM
+};
+MetadataForeignStats metadata_foreign_stats();
+
+/** Standard allocator over metadata_alloc/metadata_free. Stateless: containers that use it
+ *  keep the size and layout of their std::allocator counterparts. */
+template <class T, MetadataKind K>
+struct MetadataStlAllocator {
+    using value_type = T;
+    using is_always_equal = std::true_type;
+    template <class U>
+    struct rebind {
+        using other = MetadataStlAllocator<U, K>;
+    };
+
+    MetadataStlAllocator() noexcept = default;
+    template <class U>
+    constexpr MetadataStlAllocator(const MetadataStlAllocator<U, K> &) noexcept
+    {
+    }
+
+    T *allocate(size_t n)
+    {
+        if (n > std::numeric_limits<size_t>::max() / sizeof(T)) {
+            metadata_bad_alloc(std::numeric_limits<size_t>::max(), K);
+        }
+        void *p = metadata_alloc(n * sizeof(T), alignof(T), K);
+        if (!p) {
+            metadata_bad_alloc(n * sizeof(T), K);
+        }
+        return static_cast<T *>(p);
+    }
+    void deallocate(T *p, size_t) noexcept { metadata_free(p); }
+
+    friend bool operator==(const MetadataStlAllocator &, const MetadataStlAllocator &) noexcept { return true; }
+    friend bool operator!=(const MetadataStlAllocator &, const MetadataStlAllocator &) noexcept { return false; }
+};
+
+/**
+ * std::vector over a metadata allocator, interchangeable with std::vector<T> in ESP-DL's code:
+ * constructible and assignable from a std::vector<T>, comparable with one, and convertible to
+ * one (a copy on the default heap; use it only for temporaries).
+ */
+template <class T, MetadataKind K>
+class meta_vector : public std::vector<T, MetadataStlAllocator<T, K>> {
+    using base = std::vector<T, MetadataStlAllocator<T, K>>;
+
+public:
+    using base::base;
+    meta_vector() = default;
+    meta_vector(const meta_vector &) = default;
+    meta_vector(meta_vector &&) noexcept = default;
+    meta_vector(const std::vector<T> &other) : base(other.begin(), other.end()) {}
+    meta_vector &operator=(const meta_vector &) = default;
+    meta_vector &operator=(meta_vector &&) noexcept = default;
+    meta_vector &operator=(const std::vector<T> &other)
+    {
+        this->assign(other.begin(), other.end());
+        return *this;
+    }
+    meta_vector &operator=(std::initializer_list<T> list)
+    {
+        this->assign(list.begin(), list.end());
+        return *this;
+    }
+    operator std::vector<T>() const { return std::vector<T>(this->begin(), this->end()); }
+};
+
+template <class T, MetadataKind K>
+bool operator==(const meta_vector<T, K> &a, const std::vector<T> &b)
+{
+    if (a.size() != b.size()) {
+        return false;
+    }
+    for (size_t i = 0; i < a.size(); ++i) {
+        if (!(a[i] == b[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+template <class T, MetadataKind K>
+bool operator!=(const meta_vector<T, K> &a, const std::vector<T> &b)
+{
+    return !(a == b);
+}
+// Both orders, in every language mode: with operator!= declared, C++20 does not rewrite a
+// reversed operator== for these.
+template <class T, MetadataKind K>
+bool operator==(const std::vector<T> &a, const meta_vector<T, K> &b)
+{
+    return b == a;
+}
+template <class T, MetadataKind K>
+bool operator!=(const std::vector<T> &a, const meta_vector<T, K> &b)
+{
+    return !(b == a);
+}
+
+/** Tensor-name strings and the name map (MetadataKind::Names). */
+using meta_string = std::basic_string<char, std::char_traits<char>, MetadataStlAllocator<char, MetadataKind::Names>>;
+/** Orders names by their characters: lookups take any string type without converting it. */
+struct NameLess {
+    using is_transparent = void;
+    bool operator()(std::string_view a, std::string_view b) const noexcept { return a < b; }
+};
+template <class V>
+using meta_name_map =
+    std::map<meta_string, V, NameLess, MetadataStlAllocator<std::pair<const meta_string, V>, MetadataKind::Names>>;
+
+} // namespace tool
+} // namespace dl
+
+/**
+ * Class-scope operator new/delete for a long-lived ESP-DL class: every object of it (and of its
+ * subclasses) comes from metadata_alloc(size, ALIGN, KIND) and goes back through metadata_free.
+ * Static members only, so the class layout and vtable are unchanged. ALIGN is evaluated in the
+ * member functions, where the class is complete (alignof of the class itself is allowed).
+ * Placement new stays available.
+ */
+#define DL_METADATA_NEW_DELETE(KIND, ALIGN)                                                                \
+    static void *operator new(size_t size)                                                                 \
+    {                                                                                                      \
+        void *p = ::dl::tool::metadata_alloc(size, (ALIGN), ::dl::tool::MetadataKind::KIND);               \
+        if (!p) {                                                                                          \
+            ::dl::tool::metadata_bad_alloc(size, ::dl::tool::MetadataKind::KIND);                          \
+        }                                                                                                  \
+        return p;                                                                                          \
+    }                                                                                                      \
+    static void *operator new(size_t size, const std::nothrow_t &) noexcept                               \
+    {                                                                                                      \
+        return ::dl::tool::metadata_alloc(size, (ALIGN), ::dl::tool::MetadataKind::KIND);                  \
+    }                                                                                                      \
+    static void *operator new(size_t, void *where) noexcept                                               \
+    {                                                                                                      \
+        return where;                                                                                      \
+    }                                                                                                      \
+    static void operator delete(void *ptr) noexcept                                                       \
+    {                                                                                                      \
+        ::dl::tool::metadata_free(ptr);                                                                    \
+    }                                                                                                      \
+    static void operator delete(void *ptr, const std::nothrow_t &) noexcept                               \
+    {                                                                                                      \
+        ::dl::tool::metadata_free(ptr);                                                                    \
+    }                                                                                                      \
+    static void operator delete(void *, void *) noexcept                                                  \
+    {                                                                                                      \
+    }
