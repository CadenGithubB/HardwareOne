+++ b/libraries/BLE/src/BLESecurity.cpp
@@ -60,6 +60,23 @@
 #if defined(CONFIG_BLUEDROID_ENABLED)
 uint8_t BLESecurity::m_keySize = 16;
 esp_ble_sec_act_t BLESecurity::m_securityLevel;
+BLESecurity::Policy BLESecurity::policy() {
+  return {m_authReq, m_iocap, m_initKey, m_respKey, m_keySize};
+}
+esp_err_t BLESecurity::applyPolicy(const Policy& p) {
+  const esp_ble_sm_param_t kinds[] = {ESP_BLE_SM_AUTHEN_REQ_MODE, ESP_BLE_SM_IOCAP_MODE,
+    ESP_BLE_SM_SET_INIT_KEY, ESP_BLE_SM_SET_RSP_KEY, ESP_BLE_SM_MAX_KEY_SIZE};
+  uint8_t values[] = {p.authentication, p.capability, p.initiatorKeys, p.responderKeys, p.keySize};
+  uint8_t* mirrors[] = {&m_authReq, &m_iocap, &m_initKey, &m_respKey, &m_keySize};
+  esp_err_t first = ESP_OK;
+  for (unsigned i = 0; i < sizeof(values); ++i) {
+    const esp_err_t result = esp_ble_gap_set_security_param(kinds[i], &values[i], sizeof(uint8_t));
+    if (result == ESP_OK) *mirrors[i] = values[i];
+    else if (first == ESP_OK) first = result;
+  }
+  return first;
+}
+
 FreeRTOS::Semaphore *BLESecurity::m_authCompleteSemaphore = nullptr;
 #endif
 
