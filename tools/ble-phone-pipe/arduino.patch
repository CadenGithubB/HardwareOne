+namespace {
+// [hardwareone local patch 2026-10-22, memory audit BLE-03] GATTC app ids held
+// by clients the routing map may not list (registering, retiring, quarantined):
+// a 64-entry table in place of a 4 KB bitmap over the 15-bit id space. Bluedroid
+// registers at most 4 GATTC apps and the application keeps at most 3 retired
+// clients, so a full table means a leak, not a load; allocateAppId then refuses
+// (connect() reads that as ESP_ERR_NO_MEM). Written under the client registry
+// guard, as the map is.
+constexpr size_t kReservedAppIdSlots = 64;
+uint16_t sReservedAppIds[kReservedAppIdSlots];
+size_t sReservedAppIdCount = 0;
+bool appIdReserved(uint16_t id) {
+  for (size_t i = 0; i < sReservedAppIdCount; ++i) if (sReservedAppIds[i] == id) return true;
+  return false;
+}
+void unreserveAppId(uint16_t id) {
+  for (size_t i = 0; i < sReservedAppIdCount; ++i) {
+    if (sReservedAppIds[i] != id) continue;
+    sReservedAppIds[i] = sReservedAppIds[--sReservedAppIdCount];
+    return;
+  }
+}
+}
+bool BLEDevice::allocateAppId(uint16_t& id) {
+  BLEClientRegistryGuard guard;
+  if(sReservedAppIdCount==kReservedAppIdSlots)return false;
+  for(unsigned tried=0;tried<32768;++tried) {
+    const uint16_t candidate=m_appId++ & 0x7fff;
+    if(appIdReserved(candidate) || m_connectedClientsMap.count(candidate))continue;
+    sReservedAppIds[sReservedAppIdCount++]=candidate;id=candidate;return true;
   }
+  return false;
 }
+void BLEDevice::releaseAppId(uint16_t id) {
+  if(id>0x7fff)return;
+  BLEClientRegistryGuard guard;
+  unreserveAppId(id);
+}
