# Custom partition table with spiffs for LittleFS storage
# HardwareOne shared sdkconfig defaults
#
# This file is loaded for every build target and only contains settings that are
# intended to be common across supported boards.
#
# Board/chip-specific settings such as Arduino variant, PSRAM mode, flash mode,
# and Bluetooth capabilities must live in the target-specific files:
#   - sdkconfig.defaults.esp32
#   - sdkconfig.defaults.esp32s3
#
# To build correctly:
#   1. Run `idf.py set-target <chip>` to choose the chip family.
#   2. Make sure the target-specific defaults file sets the matching
#      `CONFIG_ARDUINO_VARIANT` for the board you want.
#   3. BuildConfig then auto-selects the proper board definitions from that
#      variant so pins, PSRAM assumptions, and hardware feature flags line up.
#
# If you switch chip families (for example ESP32 <-> ESP32-S3), run
# `idf.py fullclean` first. See docs/BOARD_SWITCHING.md for full instructions.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# CPU frequency - 240MHz for faster TLS handshakes
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Per-task TLS storage pointers. The IDF default is 1, which is not enough:
# slot 0 is owned by ESP-IDF's pthread library (pthread_getspecific reads it
# from inside libc / ArduinoJson serialization paths). The HardwareOne auth-
# identity code uses slot 1 for its per-task TaskIdentity struct (see
# System_AuthIdentity.cpp). With only 1 slot, slot-1 reads return junk and
# anything in broadcastOutput's capture path StoreProhibited-crashes during
# first-time setup. Raise to 4 to leave headroom for additional TLS users.
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=4

# Arduino core requirements
CONFIG_FREERTOS_HZ=1000

# FreeRTOS trace & runtime stats (needed for uxTaskGetSystemState, vTaskList, etc.)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Stack sizes - tuned for this app
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2304
# 1536, not the IDF default (1024 generic / 1280 on S3): the S3 carves the AI
# coprocessor context save area out of every task stack, so nominal bytes buy
# less usable depth there. Applied to all boards for uniform headroom.
CONFIG_ESP_IPC_TASK_STACK_SIZE=1536
CONFIG_ESP_TIMER_TASK_STACK_SIZE=3584
CONFIG_ESP_MINIMAL_SHARED_STACK_SIZE=2048
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192
CONFIG_ARDUINO_SERIAL_EVENT_TASK_STACK_SIZE=2048
CONFIG_ARDUINO_UDP_TASK_STACK_SIZE=4096

# BLE stack sizes
# =============================================================================
# Bluetooth — currently DISABLED at the SDK level
# =============================================================================
# Setting CONFIG_BT_ENABLED=n drops the entire Bluedroid stack + controller +
# PHY radio control from the binary. Frees roughly:
#   ~14 KB IRAM         (was ~99% full with BT enabled — most of the headroom)
#   ~70 KB Flash code   (libbtdm_app + libbt + libbtbb)
#   ~80 KB DRAM bss/data (BT pools, queues, GATT cache)
#
# The application-level mirror is `ENABLE_BLUETOOTH=0` in
# components/hardwareone/System_BuildConfig.h. Both must be flipped together
# to fully disable Bluetooth.
#
# To re-enable: change to `=y` here, change `ENABLE_BLUETOOTH 1` in
# System_BuildConfig.h, then `idf.py fullclean && idf.py build`. The
# config-suite settings further down (BTC/BTU stack sizes, GATT cache, etc.)
# are kept commented but not removed so the re-enable diff is small.
# When BT is on with BLE 5.0 (CONFIG_BT_BLE_50_FEATURES_SUPPORTED), you must
# also set CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y or Arduino's Bluedroid BLE
# library will fail to link (legacy esp_ble_gap_* / esp_ble_gattc_* APIs).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# Settings below ONLY apply when CONFIG_BT_ENABLED=y. Kept here as an audit
# trail of the tuning that was done while BT was active. They're inert when
# BT is disabled (no ESP-IDF kconfig dependency picks them up).
#
# BTC was 3072 — too tight for the G2 hijack tap dispatcher, which runs on
# the BTC task and can transitively call g2ShowText (1 KB rebuild buffer)
# and per-page handlers. Overflowed when tapping Status from the hijacked
# Blocks menu. 8192 matches the ESP-IDF default for BLE-rich projects.
CONFIG_BT_BTC_TASK_STACK_SIZE=8192
CONFIG_BT_BTU_TASK_STACK_SIZE=4352
# Route Bluedroid host allocations to PSRAM first, keeping internal DRAM free.
# This was =y during active G2 work but was silently dropped when commit
# 9a23158 ("BSS-to-PSRAM diversion") regenerated sdkconfig against the wrong
# PSRAM target; it never got restored when the SPIRAM mode was fixed back to
# octal. Pinned here so it survives future regenerations. Complements
# CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY below.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
# Move BLE host structs to the heap (PSRAM-backed) instead of BSS. Frees
# ~14 KB of internal SRAM and gives the BT stack more headroom for HCI
# command queue / fixed_pkt_queue allocations under load.
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# BLE GATT configuration (also inert when BT is off)
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=100
CONFIG_BT_GATT_MAX_SR_PROFILES=8
CONFIG_BT_GATTC_MAX_CACHE_CHAR=40

# BLE controller sizing — trimmed from IDF defaults (MAX_ACT=6 / ACL=4) to
# reclaim internal/DMA SRAM, then sized for the real worst case:
#   G2 (2 temples) + R1 ring (1) + 1 spare = 4 connections, + 1 scan/adv = 5 acts.
# HW-confirmed 2026-06-07: G2+R1 = 3 simultaneous connections worked at ACL=3, but
# that's zero headroom. ACL=4 / MAX_ACT=5 gives one spare connection for the planned
# ESP-brokered G2<->R1 pairing handshake (and transient reconnects / a future phone
# link). Cost is only ~2-4 KB internal vs the ~46 KB BT-active floor. SCAN_DUPL_CACHE
# 100->30: scan env has <~30 distinct advertisers; overflow only causes duplicate adv
# callbacks (no crash) and G2 filters by name. See docs/MEMORY_LAYOUT.md §5/§9.
CONFIG_BT_CTRL_BLE_MAX_ACT=5
CONFIG_BT_ACL_CONNECTIONS=4
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=30

# Interrupt watchdog - 1500ms gives headroom for I2C FSM reset under HTTPS load
# The I2C driver's i2c_hw_fsm_reset enters nested spinlocks (I2C + periph clock),
# which can stall under heavy WiFi/TLS peripheral contention.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1500

# HTTP Server - increase header buffer for browser cookies
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# LWIP - raise the global BSD socket pool. The HTTPS server uses 8 client
# sockets (WebServer_Server.cpp) and esp_http_server requires
# LWIP_MAX_SOCKETS >= max_open_sockets + 3 (listener + 2 control), i.e. >= 11;
# 16 leaves headroom for MQTT-over-TLS / SNTP / mDNS. Each extra slot is only a
# few hundred bytes of internal DRAM (netconn + recvmbox); the heavy per-session
# TLS content buffers live in PSRAM via CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC below.
# (CONFIG_LWIP_MAX_ACTIVE_TCP already defaults to 16, which covers 8 sockets.)
CONFIG_LWIP_MAX_SOCKETS=16

# SNTP - make the two backup servers setupNTP() passes actually exist (the
# default is ONE slot, which silently dropped them), and stop waiting a random
# 0-5 s before the first request — boot's foreground sync polls for the reply,
# so the startup delay was pure added latency. Deliberately NOT enabling
# CONFIG_LWIP_DHCP_GET_NTP_SRV: when armed it wipes the entire static server
# list, not just slot 0.
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_SNTP_MAXIMUM_STARTUP_DELAY=100

# mbedTLS - allocate TLS buffers from PSRAM instead of internal DRAM
# Each TLS session needs ~40-50KB; internal DRAM is too scarce for multiple sessions
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# HTTPS performance: enable session ticket resumption (skip full handshake on reconnect).
# NOTE: this Kconfig only compiles in support. The httpd_ssl runtime flag must
# also be set — sslConfig.session_tickets = true — done in WebServer_Server.cpp.
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y

# Don't keep peer certificate after handshake (no mutual TLS, saves RAM per session)
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set

# IRAM savings - disable IRAM placement for non-critical drivers
# CONFIG_GDMA_CTRL_FUNC_IN_IRAM is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM is not set
# CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE is not set
# CONFIG_DAC_CTRL_FUNC_IN_IRAM is not set
# CONFIG_DAC_ISR_IRAM_SAFE is not set
# CONFIG_GPIO_CTRL_FUNC_IN_IRAM is not set
# CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM is not set
# CONFIG_GPTIMER_ISR_IRAM_SAFE is not set
# CONFIG_I2C_ISR_IRAM_SAFE is not set
# CONFIG_I2S_ISR_IRAM_SAFE is not set
# CONFIG_LEDC_CTRL_FUNC_IN_IRAM is not set
# CONFIG_MCPWM_ISR_IRAM_SAFE is not set
# CONFIG_MCPWM_CTRL_FUNC_IN_IRAM is not set
# CONFIG_PCNT_CTRL_FUNC_IN_IRAM is not set
# CONFIG_PCNT_ISR_IRAM_SAFE is not set
# CONFIG_RMT_ISR_IRAM_SAFE is not set
# CONFIG_RMT_RECV_FUNC_IN_IRAM is not set
# CONFIG_SDM_CTRL_FUNC_IN_IRAM is not set
# CONFIG_SPI_MASTER_IN_IRAM is not set
# CONFIG_SPI_SLAVE_IN_IRAM is not set
# CONFIG_TOUCH_CTRL_FUNC_IN_IRAM is not set
# CONFIG_TOUCH_ISR_IRAM_SAFE is not set
# CONFIG_UART_ISR_IN_IRAM is not set
# CONFIG_ETH_IRAM_OPTIMIZATION is not set
# CONFIG_ESP_PANIC_HANDLER_IRAM is not set
# CONFIG_TWAI_ISR_IN_IRAM is not set

# Compiler options
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# Keep these in IRAM (needed for stability)
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y
CONFIG_SPI_SLAVE_ISR_IN_IRAM=y
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=y
CONFIG_PERIPH_CTRL_FUNC_IN_IRAM=y
CONFIG_ESP_SPI_BUS_LOCK_ISR_FUNCS_IN_IRAM=y

# ESP-SR configuration - models packed into the on-flash 'model' partition.
# The runtime srModelSource setting (gSettings.srModelSource) defaults to 0
# = partition mode. With CONFIG_MODEL_IN_SDCARD=y the build packages models
# in a format meant for /sd/srmodels/ which the partition loader cannot
# parse — esp_srmodel_filter(WN_PREFIX) returns NULL even though wn9_*
# files are physically present in the partition. Use MODEL_IN_FLASH so the
# bundle format matches the load path. Partition sizing is in
# partitions_sr.csv (~3 MB for WN9_HILEXIN + EN_MN7 + fst).
CONFIG_MODEL_IN_FLASH=y
# CONFIG_MODEL_IN_SDCARD is not set
CONFIG_USE_AFE=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_USE_WAKENET=y
CONFIG_SR_WN_WN9_HILEXIN=y
CONFIG_USE_MULTINET=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
# Chinese model: pick "None" explicitly. ESP-SR's kconfig has a `choice`
# block for the Chinese model with `default SR_MN_CN_MULTINET6_QUANT`. The
# old `# CONFIG_SR_MN_CN_MULTINET6_QUANT is not set` style does NOT work
# inside a choice block — kconfig will just fall back to the default.
# Setting CONFIG_SR_MN_CN_NONE=y picks the None option in the choice and
# keeps srmodels.bin small enough to fit the 3 MB model partition (with
# CN MN6 enabled, srmodels.bin balloons to ~6.4 MB and overflows the
# partition at flash time).
CONFIG_SR_MN_CN_NONE=y

# PSRAM common settings (mode set per-target)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# FAT long-filename support for SD card (heap-backed; uses PSRAM-capable heap).
# Required so video recordings and other files can use names longer than 8.3.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_ANSI_OEM=y
