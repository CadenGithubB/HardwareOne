# ESP32 family build configuration — common to ALL ESP32 (classic) boards.
# Loaded automatically by ESP-IDF when target is esp32 (idf.py set-target esp32).
# Do not delete. Controls PSRAM presence/speed, flash mode, and Bluetooth stack.
#
# BOARD-SPECIFIC settings (CONFIG_ARDUINO_VARIANT, CONFIG_SPIRAM_MODE_*,
# CONFIG_PICO_PSRAM_CS_IO, CONFIG_ESPTOOLPY_FLASHSIZE_*) are NOT here — they
# live in boards/<name>.defaults and get layered on top via the HW_BOARD
# selection logic in CMakeLists.txt. To switch boards:
#   HW_BOARD=feather_esp32_v2 idf.py set-target esp32 && idf.py fullclean && idf.py build
# (default HW_BOARD for esp32 is qtpy_esp32.) See docs/BOARD_SWITCHING.md.
#
# If you are switching from ESP32-S3 back to ESP32, run `idf.py fullclean`
# before building so the proper esp32 defaults are re-applied cleanly.

# PSRAM presence + type + speed (mode + CS are board-specific — see
# boards/<name>.defaults). All currently-supported ESP32 boards (QT Py,
# Feather V2) carry Quad PSRAM at 40 MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y

# Flash mode
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Bluetooth - ENABLED (BLE-only) for the G2 glasses on the QT Py. The Bluedroid
# stack + controller are a tight fit in the ESP32-classic's IRAM alongside WiFi +
# web + ESP-NOW; if the link overflows iram0_0_seg, drop features to recover space.
# (kept in sync with ENABLE_BLUETOOTH in System_BuildConfig.h.)
CONFIG_BT_ENABLED=y
# BLE-only controller (no BR/EDR Classic) — G2 is a BLE central; saves RAM/flash.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# Bluedroid host (CONFIG_BT_BLUEDROID_ENABLED) + BLE 4.2 come from sdkconfig.defaults.

# IRAM recovery: BLE-only BT overruns the ESP32-classic's IRAM by a few hundred
# bytes (iram0_0_seg overflowed by 468 B), so move non-ISR FreeRTOS functions to
# flash — frees several KB of IRAM at negligible runtime cost (ISR-safe funcs stay
# in IRAM). Required for the BT + G2 build to link on esp32-classic.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# Min chip revision: the QT Py's ESP32-PICO-V3-02 is rev v3.0, where the original
# ESP32 PSRAM-cache silicon bug is FIXED. Targeting rev 3 lets us turn off the
# cache workaround below — which otherwise pins ~12 libc groups (str/mem/math/…)
# into IRAM, and on the classic ESP32 IRAM shares SRAM with the heap, so this
# reclaims both IRAM and runtime heap.
# NOTE: the image will then only boot on rev-3+ ESP32 silicon (the QT Py qualifies).
CONFIG_ESP32_REV_MIN_3=y
CONFIG_SPIRAM_CACHE_WORKAROUND=n
