# Optional SDK policy is layered separately from hardware defaults. Keep this
# helper independent of ESP-IDF so policy transitions can be tested with cmake -P.

function(hw1_sdkconfig_policy_files _repo _board _feature _named _deployment _output)
    set(_shared "${_repo}/presets/sdkconfig.defaults")
    set(_files "${_shared}")
    set(_preset "${_repo}/presets/${_board}.sdkconfig.defaults")
    if(EXISTS "${_preset}")
        list(APPEND _files "${_preset}")
    endif()
    if(NOT "${_named}" STREQUAL "")
        if(NOT "${_deployment}" STREQUAL "")
            message(FATAL_ERROR "Named SDK choices cannot be combined with a deployment SDK contract")
        endif()
        if("${_feature}" STREQUAL "")
            message(FATAL_ERROR "HW1_SDK_CONFIG_FILE requires HW1_FEATURE_CONFIG_FILE")
        endif()
        if(NOT EXISTS "${_named}" OR IS_DIRECTORY "${_named}")
            message(FATAL_ERROR "HW1 SDK configuration is missing or not a file: ${_named}")
        endif()
        # The shared policy file is also the list of editable SDK choices.
        # Hardware geometry, partitions and provisioning are not optional
        # feature settings and cannot be introduced by a named configuration.
        file(STRINGS "${_shared}" _choices REGEX "^CONFIG_[A-Z0-9_]+=[yn]$")
        set(_keys "")
        foreach(_choice IN LISTS _choices)
            string(REGEX REPLACE "=[yn]$" "" _key "${_choice}")
            list(APPEND _keys "${_key}")
        endforeach()
        file(STRINGS "${_named}" _lines)
        foreach(_line IN LISTS _lines)
            string(STRIP "${_line}" _line)
            if(_line MATCHES "^# CONFIG_[A-Z0-9_]+ is not set$")
                message(FATAL_ERROR "Named SDK choices must use CONFIG_...=n instead of not-set comments")
            endif()
            if(_line STREQUAL "" OR _line MATCHES "^#")
                continue()
            endif()
            if(NOT _line MATCHES "^(CONFIG_[A-Z0-9_]+)=[yn]$")
                message(FATAL_ERROR "Invalid named SDK choice: ${_line}; expected CONFIG_...=y or n")
            endif()
            set(_key "${CMAKE_MATCH_1}")
            if(NOT _key IN_LIST _keys)
                message(FATAL_ERROR "${_key} is not an editable SDK choice in presets/sdkconfig.defaults")
            endif()
        endforeach()
        list(APPEND _files "${_named}")
    endif()
    if(NOT "${_deployment}" STREQUAL "")
        list(APPEND _files "${_deployment}")
    endif()
    set(${_output} "${_files}" PARENT_SCOPE)
endfunction()

function(hw1_reconcile_sdkconfig _sdkconfig)
    if(NOT EXISTS "${_sdkconfig}")
        return()
    endif()
    # Later files win, matching SDKCONFIG_DEFAULTS. Reconcile each key only
    # against its final value, so a preset cannot undo a selected override.
    set(_keys "")
    foreach(_file IN LISTS ARGN)
        file(STRINGS "${_file}" _settings REGEX "^CONFIG_[A-Z0-9_]+=")
        foreach(_setting IN LISTS _settings)
            string(REGEX MATCH "^(CONFIG_[A-Z0-9_]+)=" _ "${_setting}")
            set(_key "${CMAKE_MATCH_1}")
            list(APPEND _keys "${_key}")
            set(_expected_${_key} "${_setting}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _keys)
    file(READ "${_sdkconfig}" _sdk_contents)
    set(_changed_keys "")
    foreach(_key IN LISTS _keys)
        set(_setting "${_expected_${_key}}")
        # Use literal lines, not a regex containing the value: quoted file
        # names and other values can contain regular-expression punctuation.
        string(REPLACE "\n" ";" _sdk_lines "${_sdk_contents}")
        if(_setting IN_LIST _sdk_lines)
            continue()
        endif()
        if(_setting MATCHES "=n$" AND "# ${_key} is not set" IN_LIST _sdk_lines)
            continue()
        endif()

        # Kconfig defaults apply only to unset options. Remove stale values;
        # IDF then resolves the selected defaults and their real dependencies.
        set(_before "${_sdk_contents}")
        string(REGEX REPLACE "(^|\n)${_key}=[^\n]*" "\\1" _sdk_contents "${_sdk_contents}")
        string(REGEX REPLACE "(^|\n)# ${_key} is not set" "\\1" _sdk_contents "${_sdk_contents}")

        # Preserve the existing board-switch recovery for hardware choices.
        # Their old active sibling would otherwise defeat the selected default.
        if(_key STREQUAL "CONFIG_SPIRAM_MODE_OCT" OR _key STREQUAL "CONFIG_SPIRAM_MODE_QUAD")
            string(REGEX REPLACE "(^|\n)CONFIG_SPIRAM_MODE_(OCT|QUAD)=[^\n]*" "\\1" _sdk_contents "${_sdk_contents}")
            string(REGEX REPLACE "(^|\n)# CONFIG_SPIRAM_MODE_(OCT|QUAD) is not set" "\\1" _sdk_contents "${_sdk_contents}")
        elseif(_key MATCHES "^CONFIG_ESPTOOLPY_FLASHSIZE_[0-9]+MB$")
            string(REGEX REPLACE "(^|\n)CONFIG_ESPTOOLPY_FLASHSIZE_[0-9]+MB=[^\n]*" "\\1" _sdk_contents "${_sdk_contents}")
            string(REGEX REPLACE "(^|\n)# CONFIG_ESPTOOLPY_FLASHSIZE_[0-9]+MB is not set" "\\1" _sdk_contents "${_sdk_contents}")
            string(REGEX REPLACE "(^|\n)CONFIG_ESPTOOLPY_FLASHSIZE=\"[^\"]*\"" "\\1" _sdk_contents "${_sdk_contents}")
        endif()
        if(NOT _before STREQUAL _sdk_contents)
            list(APPEND _changed_keys "${_key}")
        endif()
    endforeach()
    if(_changed_keys)
        string(REGEX REPLACE "\n\n+" "\n" _sdk_contents "${_sdk_contents}")
        file(WRITE "${_sdkconfig}" "${_sdk_contents}")
        string(JOIN ", " _changed_str ${_changed_keys})
        message(STATUS "Cleared stale [${_changed_str}] from sdkconfig so selected hardware and SDK policy re-apply")
    endif()
endfunction()
