# HardwareOne factory recovery updater: common ESP-IDF-only defaults.
#
# BOARD-SPECIFIC SETTINGS DO NOT BELONG HERE. Flash size, partition-table
# offset, console peripheral and chip revision all live in
# updater/boards/<board>.defaults; the partition table filename is generated
# by updater/CMakeLists.txt so the updater and the main application always
# compile the SAME csv. A 16 MB flash size and a USB-Serial/JTAG console used
# to be pinned in this file, which is why the project could only ever be built
# for an ESP32-S3: the classic ESP32 has no such console peripheral.
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=n

CONFIG_BT_ENABLED=n
CONFIG_SPIRAM=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Console channel is per-board (see above); only the shared baud rate is here.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

CONFIG_LITTLEFS_OBJ_NAME_LEN=96
CONFIG_LITTLEFS_CACHE_SIZE=256
CONFIG_LITTLEFS_LOOKAHEAD_SIZE=128
CONFIG_LITTLEFS_ASSERTS=y

# Direct upload uses one long-lived request plus status/control traffic.
CONFIG_HTTPD_MAX_URI_LEN=128
