+// [hardwareone local patch 2026-10-22, memory audit BLE-02/BLE-09] Semaphore
+// slimmed to handle + value and its kernel object made on first use; see RTOS.h.
+namespace {
+// Guards the one-time publication of a Semaphore's kernel object.
+portMUX_TYPE sSemaphoreMakeMux = portMUX_INITIALIZER_UNLOCKED;
+}
+
 /**
+ * @brief The kernel object, made on first use: a binary semaphore left
+ * available, as the constructor used to. Two tasks racing here make two and
+ * keep the first published; the loser's is deleted.
+ */
+SemaphoreHandle_t FreeRTOS::Semaphore::handle() {
+  SemaphoreHandle_t made = m_semaphore.load(std::memory_order_acquire);
+  if (made) return made;
+  made = xSemaphoreCreateBinary();
+  if (!made) return nullptr;
+  xSemaphoreGive(made);
+  SemaphoreHandle_t expected = nullptr;
+  portENTER_CRITICAL(&sSemaphoreMakeMux);
+  const bool published =
+    m_semaphore.compare_exchange_strong(expected, made, std::memory_order_acq_rel);
+  portEXIT_CRITICAL(&sSemaphoreMakeMux);
+  if (published) return made;
+  vSemaphoreDelete(made);
+  return expected;
+}
