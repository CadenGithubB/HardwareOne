diff --git a/cores/esp32/esp32-hal-hosted.h b/cores/esp32/esp32-hal-hosted.h
--- a/cores/esp32/esp32-hal-hosted.h
+++ b/cores/esp32/esp32-hal-hosted.h
@@ -44,6 +44,13 @@
 // after checked teardown. Release does not shut down the shared transport.
 bool hostedClaimBLE();
 void hostedReleaseBLE();
+// [hardwareone local patch 2026-10-02] A companion that stopped answering
+// (SDIO failure, C6 reset, update in progress) cannot acknowledge its own
+// shutdown. While "lost", the Wi-Fi and BLE teardown paths skip or forgive
+// the companion RPCs, so the host-side state is released and the transport
+// can be rebuilt without rebooting the host. Cleared by a successful init.
+void hostedSetTransportLost(bool lost);
+bool hostedTransportLost(void);
 bool hostedIsInitialized();
 bool hostedIsBLEActive();
 bool hostedIsWiFiActive();
diff --git a/cores/esp32/esp32-hal-hosted.c b/cores/esp32/esp32-hal-hosted.c
--- a/cores/esp32/esp32-hal-hosted.c
+++ b/cores/esp32/esp32-hal-hosted.c
@@ -28,7 +28,16 @@
 static bool hosted_initialized = false;
 static bool hosted_ble_active = false;
 static bool hosted_wifi_active = false;
+static bool hosted_transport_lost = false;  // [hardwareone local patch 2026-10-02]
 
+void hostedSetTransportLost(bool lost) {
+  hosted_transport_lost = lost;
+}
+
+bool hostedTransportLost(void) {
+  return hosted_transport_lost;
+}
+
 static sdio_pin_config_t sdio_pin_config = {
 #ifdef BOARD_HAS_SDIO_ESP_HOSTED
   .pin_clk = BOARD_SDIO_ESP_HOSTED_CLK,
@@ -215,6 +224,7 @@
       hosted_initialized = false;
       return false;
     }
+    hosted_transport_lost = false;  // [hardwareone local patch 2026-10-02] fresh link
     hostedHasUpdate();
     return true;
   }
@@ -291,6 +301,15 @@
 
 bool hostedDeinitBLE() {
   log_i("Deinitializing ESP-Hosted for BLE");
+  if (hosted_transport_lost) {
+    // [hardwareone local patch 2026-10-02] The controller went away with the
+    // companion; only the host-side bookkeeping remains to release.
+    hosted_ble_active = false;
+    if (!hosted_wifi_active) {
+      return hostedDeinit();
+    }
+    return true;
+  }
   esp_err_t err = esp_hosted_bt_controller_disable();
   if (err != ESP_OK) {
     log_e("esp_hosted_bt_controller_disable failed: %s", esp_err_to_name(err));
diff --git a/cores/esp32/esp32-hal-bt.c b/cores/esp32/esp32-hal-bt.c
--- a/cores/esp32/esp32-hal-bt.c
+++ b/cores/esp32/esp32-hal-bt.c
@@ -104,7 +104,9 @@
   if (err != ESP_OK) return err;
   sHostedHciAttached = false;
   const int32_t before = btHostedControllerStatus();
-  err = esp_hosted_bt_controller_disable();
+  // [hardwareone local patch 2026-10-02] A lost companion cannot acknowledge;
+  // its controller is gone with it, so the host records the terminal state.
+  err = hostedTransportLost() ? ESP_OK : esp_hosted_bt_controller_disable();
   // With an unknown starting state, disable alone does not prove initialized.
   // Deinit is idempotent and establishes the terminal state in the next phase.
   const int32_t disabledState = before == BT_HOSTED_CONTROLLER_IDLE ? BT_HOSTED_CONTROLLER_IDLE
@@ -121,7 +123,8 @@
   }
   // Never release C6 controller memory: BLE must be reopenable and Wi-Fi,
   // ESP-NOW, and the shared Hosted/SDIO connection must remain operational.
-  esp_err_t err = esp_hosted_bt_controller_deinit(false);
+  // [hardwareone local patch 2026-10-02] see btHostedControllerDisable().
+  esp_err_t err = hostedTransportLost() ? ESP_OK : esp_hosted_bt_controller_deinit(false);
   hostedControllerAcknowledge(err, BT_HOSTED_CONTROLLER_IDLE);
   if (err == ESP_OK) hostedReleaseBLE();
   return err;
