+BLEClientConnectOutcome BLEClient::getLastConnectOutcome() const {
+  BLEClientConnectOutcome outcome;
+  portENTER_CRITICAL(&m_connectOutcomeMux);
+  outcome = m_lastConnectOutcome;
+  portEXIT_CRITICAL(&m_connectOutcomeMux);
