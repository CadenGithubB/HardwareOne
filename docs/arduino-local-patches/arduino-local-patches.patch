+const char *BLEClient::connectStageToString(BLEClientConnectStage stage) {
+  switch (stage) {
+    case BLEClientConnectStage::NONE:               return "none";
+    case BLEClientConnectStage::PRECHECK:           return "precheck";
+    case BLEClientConnectStage::APP_REGISTER_API:   return "app-register-api";
+    case BLEClientConnectStage::APP_REGISTER_EVENT: return "app-register-event";
+    case BLEClientConnectStage::APP_REGISTER_TIMEOUT: return "app-register-timeout";
+    case BLEClientConnectStage::OPEN_API:           return "open-api";
+    case BLEClientConnectStage::OPEN_EVENT:         return "open-event";
+    case BLEClientConnectStage::OPEN_TIMEOUT:       return "open-timeout";
+    case BLEClientConnectStage::COMPLETE:           return "complete";
+    default:                                        return "unknown";
+  }
+}
+
+const char *BLEClient::unregisterStateToString(BLEClientUnregisterState state) {
+  switch (state) {
+    case BLEClientUnregisterState::NOT_REQUESTED:      return "not-requested";
+    case BLEClientUnregisterState::REQUESTED:          return "requested";
+    case BLEClientUnregisterState::COMPLETED:          return "completed";
+    case BLEClientUnregisterState::REQUEST_FAILED:     return "request-failed";
+    case BLEClientUnregisterState::COMPLETION_TIMEOUT: return "completion-timeout";
+    case BLEClientUnregisterState::COMPLETED_LATE:     return "completed-late";
