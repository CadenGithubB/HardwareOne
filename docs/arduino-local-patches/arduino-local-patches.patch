+  }
+}
+
+void BLEClient::resetConnectOutcome() {
+  m_connectStartedMs = millis();
+  portENTER_CRITICAL(&m_connectOutcomeMux);
+  m_lastConnectOutcome = BLEClientConnectOutcome{};
+  portEXIT_CRITICAL(&m_connectOutcomeMux);
+}
+
+void BLEClient::setConnectOutcomeStage(
+  BLEClientConnectStage stage, int32_t espStatus, int32_t gattStatus, int32_t hostStatus
+) {
+  portENTER_CRITICAL(&m_connectOutcomeMux);
+  m_lastConnectOutcome.stage = stage;
+  if (espStatus != BLE_CLIENT_STATUS_NOT_SET) {
+    m_lastConnectOutcome.espStatus = espStatus;
+  }
+  if (gattStatus != BLE_CLIENT_STATUS_NOT_SET) {
+    m_lastConnectOutcome.gattStatus = gattStatus;
+  }
+  if (hostStatus != BLE_CLIENT_STATUS_NOT_SET) {
+    m_lastConnectOutcome.hostStatus = hostStatus;
+  }
+  m_lastConnectOutcome.elapsedMs = millis() - m_connectStartedMs;
+  portEXIT_CRITICAL(&m_connectOutcomeMux);
+}
+
+void BLEClient::finishConnectOutcome(bool success) {
+  portENTER_CRITICAL(&m_connectOutcomeMux);
+  m_lastConnectOutcome.success = success;
+  if (success) {
+    m_lastConnectOutcome.stage = BLEClientConnectStage::COMPLETE;
+  }
+  m_lastConnectOutcome.elapsedMs = millis() - m_connectStartedMs;
+  portEXIT_CRITICAL(&m_connectOutcomeMux);
+}
