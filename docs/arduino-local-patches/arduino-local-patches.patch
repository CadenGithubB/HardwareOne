+void BLEClient::setUnregisterState(BLEClientUnregisterState state, int32_t espStatus) {
+  const uint32_t elapsedMs = millis() - m_unregisterStartedMs;
+  portENTER_CRITICAL(&m_connectOutcomeMux);
+  if (state == BLEClientUnregisterState::COMPLETED
+      && m_lastConnectOutcome.unregisterState == BLEClientUnregisterState::COMPLETION_TIMEOUT) {
+    state = BLEClientUnregisterState::COMPLETED_LATE;
+  }
+  m_lastConnectOutcome.unregisterState = state;
+  if (espStatus != BLE_CLIENT_STATUS_NOT_SET) {
+    m_lastConnectOutcome.unregisterEspStatus = espStatus;
+  }
+  m_lastConnectOutcome.unregisterElapsedMs = elapsedMs;
+  portEXIT_CRITICAL(&m_connectOutcomeMux);
+}
+
+esp_err_t BLEClient::requestGattcUnregister() {
+  const esp_gatt_if_t gattcIf = getGattcIf();
+  if (gattcIf == ESP_GATT_IF_NONE) {
+    return ESP_OK;
+  }
+
+  const BLEClientConnectOutcome previous = getLastConnectOutcome();
+  if (previous.unregisterState == BLEClientUnregisterState::REQUESTED
+      || previous.unregisterState == BLEClientUnregisterState::COMPLETION_TIMEOUT) {
+    return ESP_ERR_INVALID_STATE;
+  }
+
+  m_unregisterStartedMs = millis();
+  // Consume the initially-given semaphore before requesting deregistration so
+  // an ESP_GATTC_UNREG_EVT can be acknowledged without a lost-wakeup race.
+  if (!m_semaphoreUnregEvt.take((uint32_t)0, "gattc-unregister")) {
+    setUnregisterState(BLEClientUnregisterState::REQUEST_FAILED, ESP_ERR_INVALID_STATE);
+    return ESP_ERR_INVALID_STATE;
+  }
+
+  setUnregisterState(BLEClientUnregisterState::REQUESTED);
+  const esp_err_t errRc = ::esp_ble_gattc_app_unregister(gattcIf);
+  if (errRc != ESP_OK) {
+    // No completion event is promised when the API rejects the request. Keep
+    // m_gattc_if and the BLEDevice routing entry intact so callers quarantine
+    // this client instead of deleting an object which may still receive events.
+    setUnregisterState(BLEClientUnregisterState::REQUEST_FAILED, errRc);
+    m_semaphoreUnregEvt.give();
+    return errRc;
+  }
+
+  // Store the synchronous request result without changing a COMPLETED state if
+  // the callback raced the API return.
+  portENTER_CRITICAL(&m_connectOutcomeMux);
+  m_lastConnectOutcome.unregisterEspStatus = errRc;
+  portEXIT_CRITICAL(&m_connectOutcomeMux);
+  return ESP_OK;
