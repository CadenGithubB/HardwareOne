-      break;
-    case HTTP_CODE_NO_CONTENT:
-    case HTTP_CODE_NOT_MODIFIED:
-      ///< Not Modified (No updates)
-      ret = HTTP_UPDATE_NO_UPDATES;
-      break;
-    case HTTP_CODE_NOT_FOUND:
