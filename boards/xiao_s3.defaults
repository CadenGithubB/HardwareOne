# Board overrides — Seeed XIAO ESP32-S3 family (base / Sense / Plus)
#
# This file is layered on top of sdkconfig.defaults + sdkconfig.defaults.esp32s3
# by the HW_BOARD selection logic in CMakeLists.txt. It contains ONLY the
# settings that distinguish this board from other ESP32-S3 boards.
#
# Activated by: HW_BOARD=xiao_s3

# HW_TARGET: esp32s3

# Arduino variant — picks the BSP pins_arduino.h and the ARDUINO_<NAME>_DEV
# macro that System_BuildConfig.h's #elif chain matches on for pin mapping.
CONFIG_ARDUINO_VARIANT="XIAO_ESP32S3"

# PSRAM mode — XIAO ESP32-S3 family uses Octal PSRAM at 80 MHz.
# Wrong mode boots fine but reports 0 KB PSRAM (silent failure — LLM,
# big web responses, ESP-NOW buffers will OOM at runtime).
CONFIG_SPIRAM_MODE_OCT=y

# Flash size — XIAO ESP32-S3 base/Sense have 8 MB. (XIAO Plus has 16 MB —
# if you ever switch this file to target Plus, change to 16MB and the
# partition picker in CMakeLists.txt will pick partitions_*_16mb.csv.)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Guard: this board must NEVER build with flash encryption. Only the dedicated
# feathers3_fe board enables it. The explicit =n makes the HW_BOARD
# auto-recovery in CMakeLists.txt strip a stale =y left in sdkconfig by a
# previous feathers3_fe build (a stale =y would silently produce a bootloader
# that permanently encrypts whatever board it boots on).
CONFIG_SECURE_FLASH_ENC_ENABLED=n

# Second half of the same guard, and NOT redundant: NVS_ENCRYPTION depends on
# "SECURE_FLASH_ENC_ENABLED || SOC_HMAC_SUPPORTED", and the S3 has HMAC — so a
# stale =y from a feathers3_fe build survives turning flash encryption off.
# Its key-protection choice would then re-resolve from the flash-encryption
# scheme (which does depend on FE) to the only remaining option, the HMAC
# peripheral, and the first nvs_flash_init() would BURN an eFuse key block on
# this board. Pin it off explicitly.
CONFIG_NVS_ENCRYPTION=n

# Keep the standard table offset (feathers3_fe moves it to 0x9000; the shared
# CSVs start nvs at 0xA000 so both offsets work).
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# CARRIER BUILD (2026-08-07): Bluetooth ENABLED so the G2 glasses mic can
# reach the CM5 over the UART link. Flash for the Bluedroid stack + controller
# + LC3 audio codec is recovered by dropping maps + the I2C/OLED layer
# (I2C_FEATURE_LEVEL=0, ENABLE_MAPS=0 in System_BuildConfig.h); camera kept.
# Was CONFIG_BT_ENABLED=n (binary overflowed the 5332K factory with BT + the
# fuller feature set). Revert this + the two BuildConfig flags to rebuild the
# camera+PDM-only variant.
CONFIG_BT_ENABLED=y

# Camera sensor policy — the XIAO Sense fleet uses the OV family. Keep all
# three OV variants supported by HardwareOne and compile out unrelated sensor
# drivers whose register tables otherwise consume internal DRAM permanently.
CONFIG_OV2640_SUPPORT=y
CONFIG_OV3660_SUPPORT=y
CONFIG_OV5640_SUPPORT=y
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_GC0308_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
