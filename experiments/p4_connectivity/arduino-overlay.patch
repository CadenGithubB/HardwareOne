+#include "esp_bt_main.h"
+#include "esp32-hal-hosted.h"
+
+// BLEDevice serializes lifecycle transitions. The atomic snapshot also permits
+// status readers on other tasks without claiming to query the remote hardware.
+static int32_t sHostedControllerState = BT_HOSTED_CONTROLLER_UNKNOWN;
+static bool sHostedHciAttached = false;
+
+int32_t btHostedControllerStatus(void) {
+  return __atomic_load_n(&sHostedControllerState, __ATOMIC_ACQUIRE);
+}
+
+static void hostedControllerAcknowledge(esp_err_t status, int32_t state) {
+  __atomic_store_n(&sHostedControllerState,
+                   status == ESP_OK ? state : BT_HOSTED_CONTROLLER_UNKNOWN,
+                   __ATOMIC_RELEASE);
+}
+
+bool btStarted(void) {
+  return btHostedControllerStatus() == BT_HOSTED_CONTROLLER_ENABLED;
+}
+
+bool btStart(void) {
+  return btStartMode(BT_MODE_BLE);
+}
+
+bool btStartMode(bt_mode mode) {
+  // This backend targets a BLE-only C6 controller. Shared Hosted transport and
+  // board pins must already be prepared by the application's radio backend.
+  if (mode != BT_MODE_DEFAULT && mode != BT_MODE_BLE) {
+    log_e("Hosted controller supports BLE mode only");
+    return false;
+  }
+  if (btStarted() && sHostedHciAttached) return true;
+  if (esp_bluedroid_get_status() != ESP_BLUEDROID_STATUS_UNINITIALIZED) {
+    log_e("Hosted HCI setup requires an uninitialized Bluedroid host");
+    return false;
+  }
+  // Wi-Fi may later switch off independently. Register BLE's transport
+  // ownership before controller work; a failed/ambiguous RPC must retain it
+  // until checked teardown confirms that the controller is idle.
+  if (!hostedClaimBLE()) return false;
+
+  // The pinned slave makes both calls idempotent. Repeat them after any
+  // ambiguous failure; never infer radio state from SDIO connectivity alone.
+  esp_err_t err = esp_hosted_bt_controller_init();
+  hostedControllerAcknowledge(err, BT_HOSTED_CONTROLLER_INITED);
+  if (err != ESP_OK) {
+    log_e("Hosted controller init failed: %s", esp_err_to_name(err));
+    return false;
+  }
+  err = esp_hosted_bt_controller_enable();
+  hostedControllerAcknowledge(err, BT_HOSTED_CONTROLLER_ENABLED);
+  if (err != ESP_OK) {
+    log_e("Hosted controller enable failed: %s", esp_err_to_name(err));
+    return false;
+  }
+
+  // Same HCI operations as the pinned Hosted Bluedroid host-only example.
+  // open() reuses the existing transport; it does not initialize Wi-Fi.
+  hosted_hci_bluedroid_open();
+  const esp_bluedroid_hci_driver_operations_t operations = {
+    .send = hosted_hci_bluedroid_send,
+    .check_send_available = hosted_hci_bluedroid_check_send_available,
+    .register_host_callback = hosted_hci_bluedroid_register_host_callback,
+  };
+  err = esp_bluedroid_attach_hci_driver(&operations);
+  if (err != ESP_OK) {
+    hosted_hci_bluedroid_close();
+    log_e("Hosted HCI attach failed: %s", esp_err_to_name(err));
+    return false;
+  }
+  sHostedHciAttached = true;
+  return true;
+}
+
+esp_err_t btHostedControllerDisable(void) {
+  // Host teardown must finish before detaching its HCI callbacks/controller.
+  if (esp_bluedroid_get_status() != ESP_BLUEDROID_STATUS_UNINITIALIZED) {
+    return ESP_ERR_INVALID_STATE;
+  }
+  hosted_hci_bluedroid_close();
+  esp_err_t err = esp_bluedroid_detach_hci_driver();
+  if (err != ESP_OK) return err;
+  sHostedHciAttached = false;
+  const int32_t before = btHostedControllerStatus();
+  err = esp_hosted_bt_controller_disable();
+  // With an unknown starting state, disable alone does not prove initialized.
+  // Deinit is idempotent and establishes the terminal state in the next phase.
+  const int32_t disabledState = before == BT_HOSTED_CONTROLLER_IDLE ? BT_HOSTED_CONTROLLER_IDLE
+                                : before == BT_HOSTED_CONTROLLER_UNKNOWN ? BT_HOSTED_CONTROLLER_UNKNOWN
+                                : BT_HOSTED_CONTROLLER_INITED;
+  hostedControllerAcknowledge(err, disabledState);
+  return err;
+}
+
+esp_err_t btHostedControllerDeinit(void) {
+  if (esp_bluedroid_get_status() != ESP_BLUEDROID_STATUS_UNINITIALIZED ||
+      sHostedHciAttached || btHostedControllerStatus() == BT_HOSTED_CONTROLLER_ENABLED) {
+    return ESP_ERR_INVALID_STATE;
+  }
+  // Never release C6 controller memory: BLE must be reopenable and Wi-Fi,
+  // ESP-NOW, and the shared Hosted/SDIO connection must remain operational.
+  esp_err_t err = esp_hosted_bt_controller_deinit(false);
+  hostedControllerAcknowledge(err, BT_HOSTED_CONTROLLER_IDLE);
+  if (err == ESP_OK) hostedReleaseBLE();
+  return err;
+}
+
+bool btStop(void) {
+  if (btHostedControllerDisable() != ESP_OK) return false;
+  return btHostedControllerDeinit() == ESP_OK;
+}
