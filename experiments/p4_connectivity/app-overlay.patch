+      !WiFi.softAP(args.arg(0).c_str(), args.arg(1).c_str(), channel, false, 2)) {
+    return "ERROR: Local test AP failed";
+  }
+  espnowNoteWifiChannelMayHaveChanged();
+  if (server == nullptr) {
+    extern void startHttpServer();
+    startHttpServer();
