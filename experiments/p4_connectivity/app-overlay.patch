+// Isolated experiment: native S3 HTTP client, controlled by USB admin only.
+// No host-computer networking, Wi-Fi deinit, or shared BLE lifecycle changes.
+#include "Connectivity_HttpProbe.h"
+#include "System_BuildConfig.h"
+#include "System_Utils.h"
+#include "System_Command.h"
+#include "System_AuthIdentity.h"
+#include "System_MemUtil.h"
+
+#if ENABLE_HTTP_SERVER && defined(CONFIG_IDF_TARGET_ESP32S3)
+#include "System_WiFi.h"
+#include "System_ESPNow.h"
+#include <WiFi.h>
+#include <HTTPClient.h>
+#include <mbedtls/base64.h>
+#include <mbedtls/sha256.h>
+#include <ctype.h>
+
+namespace {
+constexpr size_t MAX_BODY = 2000000, SMALL_BODY = 8192, MAX_FORM = 1400;
+constexpr uint8_t TEST_CHANNEL = 6;
+constexpr char TARGET[] = "192.168.4.1";
+String sessionCookie; // Never returned or logged; command execution is serialized.
+
+const char* serialize(JsonDocument& doc) {
+  PSRAM_STATIC_BUF(output, 16384);
+  doc["schema"] = 1;
+  doc["bridge"] = "s3-http-v1";
+  doc["connected"] = WiFi.status() == WL_CONNECTED;
+  doc["cookiePresent"] = !sessionCookie.isEmpty();
+  if (measureJson(doc) >= output_SIZE) return "{\"schema\":1,\"ok\":false,\"error\":\"output_overflow\"}";
+  serializeJson(doc, output, output_SIZE);
+  return output;
+}
+
+const char* fail(const char* reason) {
+  PSRAM_JSON_DOC(doc);
+  doc["ok"] = false;
+  doc["error"] = reason;
+  return serialize(doc);
+}
+
+bool decode(const String& encoded, uint8_t* bytes, size_t capacity, size_t& length) {
+  length = 0;
+  return mbedtls_base64_decode(bytes, capacity, &length,
+      reinterpret_cast<const unsigned char*>(encoded.c_str()), encoded.length()) == 0;
+}
+
+bool hasNull(const uint8_t* bytes, size_t length) { return memchr(bytes, 0, length) != nullptr; }
+
+struct Matcher {
+  const char* pattern;
+  size_t cursor = 0;
+  bool found = false;
+  void add(uint8_t value) {
+    if (found) return;
+    const char c = (char)tolower(value);
+    if (c == pattern[cursor]) {
+      if (pattern[++cursor] == '\0') found = true;
+    } else {
+      cursor = c == pattern[0] ? 1 : 0;
+    }
+  }
+};
+
+class BodySummary final : public Stream {
+ public:
+  size_t count = 0;
+  bool failed = false;
+  Matcher htmlOpen{"<html"}, htmlClose{"</html>"}, username{"username"}, password{"password"};
+  uint8_t* small = nullptr;
+  const uint32_t deadline = millis() + 20000;
+  mbedtls_sha256_context hash;
+  BodySummary() {
+    small = static_cast<uint8_t*>(ps_alloc(SMALL_BODY, AllocPolicy::PreferPSRAM, "http.probe.body"));
+    mbedtls_sha256_init(&hash);
+    failed = !small || mbedtls_sha256_starts(&hash, 0) != 0;
+  }
+  ~BodySummary() { mbedtls_sha256_free(&hash); ps_free(small); }
+  int available() override { return 0; }
+  int read() override { return -1; }
+  int peek() override { return -1; }
+  void flush() override {}
+  size_t write(uint8_t byte) override { return write(&byte, 1); }
+  size_t write(const uint8_t* bytes, size_t length) override {
+    if (failed || int32_t(deadline - millis()) <= 0 || length > MAX_BODY - count ||
+        mbedtls_sha256_update(&hash, bytes, length) != 0) {
+      failed = true;
+      setWriteError();
+      return 0;
+    }
+    if (count + length <= SMALL_BODY && length) memcpy(small + count, bytes, length);
+    for (size_t i = 0; i < length; ++i) {
+      htmlOpen.add(bytes[i]); htmlClose.add(bytes[i]); username.add(bytes[i]); password.add(bytes[i]);
+    }
+    count += length;
+    return length;
+  }
+  bool finish(char hex[65]) {
+    uint8_t digest[32];
+    if (failed || mbedtls_sha256_finish(&hash, digest) != 0) return false;
+    static const char digits[] = "0123456789abcdef";
+    for (size_t i = 0; i < sizeof(digest); ++i) {
+      hex[2*i] = digits[digest[i] >> 4]; hex[2*i+1] = digits[digest[i] & 15];
+    }
+    hex[64] = '\0';
+    return true;
+  }
+};
+
+bool updateCookie(const String& header) {
+  if (header.isEmpty()) return true;
+  if (!header.startsWith("session=")) return false;
+  int end = header.indexOf(';');
+  String value = header.substring(8, end < 0 ? header.length() : end);
+  if (value.length() > 128) return false;
+  for (size_t i = 0; i < value.length(); ++i) {
+    const unsigned char c = value[i];
+    if (!isalnum(c) && c != '-' && c != '_') return false;
+  }
+  sessionCookie = value.isEmpty() ? String() : String("session=") + value;
+  return true;
+}
+
+const char* request(const CommandArgs& args) {
+  if (args.count() < 3 || args.count() > 4) return fail("request_requires_method_path_optional_form");
+  const String method = args.arg(1), path = args.arg(2);
+  if ((method != "GET" && method != "POST") || (method == "GET" && args.count() != 3) ||
+      (method == "POST" && args.count() != 4)) return fail("get_or_post_required");
+  if (path.isEmpty() || path.length() > 128 || path[0] != '/' || path.startsWith("//")) return fail("invalid_path");
+  for (size_t i = 0; i < path.length(); ++i) {
+    const unsigned char c = path[i];
+    if (c <= 32 || c >= 127 || c == '#') return fail("invalid_path");
+  }
+  const IPAddress local = WiFi.localIP();
+  if (WiFi.status() != WL_CONNECTED || local[0] != 192 || local[1] != 168 || local[2] != 4 || WiFi.channel() != TEST_CHANNEL)
+    return fail("join_test_ap_first");
+  uint8_t form[MAX_FORM]; size_t formLength = 0;
+  if (method == "POST" && (!decode(args.arg(3), form, sizeof(form), formLength) || formLength == 0 || hasNull(form, formLength)))
+    return fail("invalid_or_oversized_form");
+  NetworkClient client;
+  HTTPClient http;
+  http.setConnectTimeout(5000);
+  http.setTimeout(5000);
+  http.setReuse(false);
+  http.setFollowRedirects(HTTPC_DISABLE_FOLLOW_REDIRECTS);
+  http.setAcceptEncoding("identity");
+  if (!http.begin(client, TARGET, 80, path, false)) return fail("http_begin_failed");
+  const char* headers[] = {"Set-Cookie", "Location", "Transfer-Encoding", "Content-Encoding"};
+  http.collectHeaders(headers, sizeof(headers) / sizeof(headers[0]));
+  if (!sessionCookie.isEmpty()) http.addHeader("Cookie", sessionCookie);
+  if (method == "POST") http.addHeader("Content-Type", "application/x-www-form-urlencoded");
+  const uint32_t started = millis();
+  const int status = method == "GET" ? http.GET() : http.POST(form, formLength);
+  memset(form, 0, sizeof(form));
+  PSRAM_JSON_DOC(doc);
+  doc["op"] = "request";
+  doc["status"] = status;
+  doc["ok"] = false;
+  doc["complete"] = false;
+  if (status <= 0) {
+    http.end(); doc["error"] = "http_transport_failed"; return serialize(doc);
+  }
+  const int expected = http.getSize();
+  const bool chunked = http.header("Transfer-Encoding").equalsIgnoreCase("chunked");
+  const String encoding = http.header("Content-Encoding");
+  if ((expected < 0 && !chunked) || expected > (int)MAX_BODY ||
+      (!encoding.isEmpty() && !encoding.equalsIgnoreCase("identity"))) {
+    http.end(); doc["error"] = "unsupported_or_oversized_body"; return serialize(doc);
+  }
+  const String location = http.header("Location");
+  if (location.length() > 256 || !updateCookie(http.header("Set-Cookie"))) {
+    http.end(); doc["error"] = "invalid_response_header"; return serialize(doc);
+  }
+  BodySummary body;
+  int received = -1;
+  if (!body.failed) received = expected == 0 && !chunked ? 0 : http.writeToStream(&body);
+  const int finalExpected = http.getSize();
+  http.end();
+  char hash[65];
+  if (received < 0 || (size_t)received != body.count || (expected >= 0 && (size_t)expected != body.count) ||
+      (finalExpected >= 0 && (size_t)finalExpected != body.count) || !body.finish(hash)) {
+    doc["error"] = "body_incomplete_or_limit";
+    doc["bytes"] = body.count;
+    return serialize(doc);
+  }
+  doc["ok"] = true;
+  doc["complete"] = true;
+  doc["bytes"] = body.count;
+  doc["sha256"] = hash;
+  doc["location"] = location;
+  doc["durationMs"] = millis() - started;
+  doc["htmlOpen"] = body.htmlOpen.found;
+  doc["htmlClose"] = body.htmlClose.found;
+  doc["hasUsername"] = body.username.found;
+  doc["hasPassword"] = body.password.found;
+  doc["bodyIncluded"] = body.count <= SMALL_BODY;
+  if (body.count <= SMALL_BODY) {
+    const size_t capacity = ((body.count + 2) / 3) * 4 + 1;
+    char* encoded = static_cast<char*>(ps_alloc(capacity, AllocPolicy::PreferPSRAM, "http.probe.base64"));
+    size_t written = 0;
+    if (!encoded || mbedtls_base64_encode(reinterpret_cast<unsigned char*>(encoded), capacity, &written, body.small, body.count) != 0) {
+      ps_free(encoded); return fail("body_encoding_failed");
+    }
+    encoded[written] = '\0';
+    doc["body"] = encoded;
+    const char* result = serialize(doc);
+    ps_free(encoded);
+    return result;
+  }
+  return serialize(doc);
+}
+} // namespace
+
+static const char* cmd_httpprobe(const String& input) {
+  RETURN_VALID_IF_VALIDATE_CSTR();
+  if (currentAuthContext().transport != SOURCE_SERIAL || !currentExecIsAdmin()) return fail("serial_admin_required");
+  CommandArgs args(input);
+  if (args.unterminatedQuote()) return fail("invalid_arguments");
+  const String sub = args.count() ? args.arg(0) : "status";
+  if (sub == "request") return request(args);
+  PSRAM_JSON_DOC(doc);
+  doc["ok"] = true;
+  doc["op"] = sub;
+  if (sub == "clear" && args.count() == 1) {
+    sessionCookie = "";
+    return serialize(doc);
+  }
+  if (sub == "status" && args.count() <= 1) {
+    doc["ip"] = WiFi.localIP().toString();
+    doc["apIp"] = WiFi.softAPIP().toString();
+    doc["channel"] = WiFi.channel();
+    return serialize(doc);
+  }
+  if (sub == "join" && args.count() == 3) {
+    uint8_t ssid[33] = {}, password[64] = {};
+    size_t ssidLength = 0, passwordLength = 0;
+    if (!decode(args.arg(1), ssid, 32, ssidLength) || !decode(args.arg(2), password, 63, passwordLength) ||
+        ssidLength == 0 || passwordLength < 8 || hasNull(ssid, ssidLength) || hasNull(password, passwordLength))
+      return fail("invalid_ap_credentials");
+    WifiRadioMutationGuard guard(5000);
+    if (!guard.acquired()) return fail("radio_busy");
+    sessionCookie = "";
+    WiFi.persistent(false);
+    if (!WiFi.mode(WIFI_AP_STA) ||
+        !WiFi.softAPConfig(IPAddress(192, 168, 5, 1), IPAddress(192, 168, 5, 1), IPAddress(255, 255, 255, 0))) {
+      memset(password, 0, sizeof(password));
+      return fail("s3_ap_route_setup_failed");
+    }
+    WiFi.begin(reinterpret_cast<const char*>(ssid), reinterpret_cast<const char*>(password), TEST_CHANNEL);
+    memset(password, 0, sizeof(password));
+    const uint32_t deadline = millis() + 20000;
+    while (WiFi.status() != WL_CONNECTED && int32_t(deadline - millis()) > 0) delay(20);
+    espnowNoteWifiChannelMayHaveChanged();
+    const IPAddress local = WiFi.localIP();
+    if (WiFi.status() != WL_CONNECTED || WiFi.channel() != TEST_CHANNEL ||
+        local[0] != 192 || local[1] != 168 || local[2] != 4) return fail("test_ap_join_failed");
+    doc["ip"] = local.toString();
+    doc["apIp"] = WiFi.softAPIP().toString();
+    doc["channel"] = WiFi.channel();
+    return serialize(doc);
+  }
+  return fail("unknown_operation");
+}
