+// Isolated connectivity experiment: USB-admin GATT central on either board.
+// Never initializes/deinitializes the shared BLE core or changes its role.
+#include "Connectivity_BleProbe.h"
+#include "System_BuildConfig.h"
+#include "System_Utils.h"
+#include "System_Command.h"
+#include "System_AuthIdentity.h"
+#include "System_MemUtil.h"
+
+#if ENABLE_BLUETOOTH
+#include <BLEDevice.h>
+#include <BLEClient.h>
+#include <BLEScan.h>
+#include <BLERemoteCharacteristic.h>
+#include <atomic>
+#include <mbedtls/base64.h>
+#include <freertos/queue.h>
+
+namespace {
+constexpr char SERVICE[] = "12345678-1234-5678-1234-56789abcdef0";
+constexpr char REQUEST[] = "12345678-1234-5678-1234-56789abcde01";
+constexpr char RESPONSE[] = "12345678-1234-5678-1234-56789abcde02";
+constexpr char PROBE_STATUS_UUID[] = "12345678-1234-5678-1234-56789abcde03";
+constexpr size_t MAX_FRAME = 517, QUEUE_DEPTH = 40;
+struct Frame { uint32_t generation; uint16_t length; uint8_t bytes[MAX_FRAME]; };
+QueueHandle_t frames = nullptr;
+BLEClient* client = nullptr;
+BLERemoteCharacteristic* requestChar = nullptr;
+BLERemoteCharacteristic* responseChar = nullptr;
+BLERemoteCharacteristic* statusChar = nullptr;
+BLERemoteService* infoService = nullptr;
+std::atomic<uint32_t> generation{0}, drops{0}, received{0};
+std::atomic<bool> connected{false};
+bool subscribed = false;
+char output[6144]; // serialized command execution owns this buffer
+
+class Callbacks final : public BLEClientCallbacks {
+  void onConnect(BLEClient*) override { connected.store(true); }
+  void onDisconnect(BLEClient*) override { connected.store(false); }
+} callbacks;
+
+const char* serialize(JsonDocument& doc) {
+  doc["schema"] = 1;
+  doc["bridge"] = "board-gatt-v1";
+  doc["generation"] = generation.load();
+  doc["connected"] = connected.load();
+  doc["drops"] = drops.load();
+  doc["received"] = received.load();
+  doc["queued"] = frames ? uxQueueMessagesWaiting(frames) : 0;
+  if (measureJson(doc) >= sizeof(output)) return "{\"schema\":1,\"ok\":false,\"error\":\"output_overflow\"}";
+  serializeJson(doc, output, sizeof(output));
+  return output;
+}
+
+const char* fail(const char* reason) {
+  PSRAM_JSON_DOC(doc);
+  doc["ok"] = false;
+  doc["error"] = reason;
+  return serialize(doc);
+}
+
+bool cleanup() {
+  ++generation; // fence notifications from the old subscription before close
+  subscribed = false;
+  if (!client) { connected.store(false); return true; }
+  if (client->isConnected() && client->disconnect() != 0) return false;
+  const uint32_t deadline = millis() + 5000;
+  while (client->isConnected() && int32_t(deadline - millis()) > 0) delay(10);
+  if (client->isConnected()) return false;
+  connected.store(false);
+  // The repository's checked delete waits for unregister acknowledgement and
+  // callback retirement. Retain the object if it cannot yet be destroyed.
+  while (int32_t(deadline - millis()) > 0) {
+    if (BLEDevice::deleteClient(client)) {
+      client = nullptr;
+      requestChar = responseChar = statusChar = nullptr;
+      infoService = nullptr;
+      if (frames) xQueueReset(frames);
+      return true;
+    }
+    delay(10);
+  }
+  return false;
+}
+
+bool validMac(const String& value) {
+  if (value.length() != 17) return false;
+  for (size_t i = 0; i < 17; ++i) {
+    if (i % 3 == 2 ? value[i] != ':' : !isxdigit(static_cast<unsigned char>(value[i]))) return false;
+  }
+  return true;
+}
+
+String base64(const uint8_t* data, size_t length) {
+  char encoded[((MAX_FRAME + 2) / 3) * 4 + 1];
+  size_t written = 0;
+  if (length > MAX_FRAME || mbedtls_base64_encode(reinterpret_cast<unsigned char*>(encoded), sizeof(encoded), &written, data, length) != 0) return String();
+  encoded[written] = '\0';
+  return String(encoded);
+}
+} // namespace
+
+static const char* cmd_bleprobe(const String& input) {
+  RETURN_VALID_IF_VALIDATE_CSTR();
+  if (currentAuthContext().transport != SOURCE_SERIAL || !currentExecIsAdmin()) return fail("serial_admin_required");
+  CommandArgs args(input);
+  const String sub = args.count() ? args.arg(0) : "status";
+  PSRAM_JSON_DOC(doc);
+  doc["ok"] = true;
+  doc["op"] = sub;
+  if (sub == "status") {
+    doc["initialized"] = BLEDevice::getInitialized();
+    doc["subscribed"] = subscribed;
+    doc["mtu"] = client && connected.load() ? client->getMTU() : 0;
+    return serialize(doc);
+  }
+  if (sub == "disconnect") {
+    if (!cleanup()) return fail("client_retirement_pending");
+    return serialize(doc);
+  }
+  if (!BLEDevice::getInitialized()) return fail("openble_required");
+  if (!frames) frames = xQueueCreate(QUEUE_DEPTH, sizeof(Frame));
+  if (!frames) return fail("queue_allocation_failed");
+  if (sub == "scan") {
+    if (client || args.count() != 2) return fail("scan_requires_disconnected_and_seconds");
+    const int seconds = args.arg(1).toInt();
+    if (seconds < 1 || seconds > 10) return fail("scan_seconds_1_to_10");
+    BLEScan* scan = BLEDevice::getScan();
+    scan->setActiveScan(true);
+    BLEScanResults* results = scan->start(seconds, false);
+    if (!results) return fail("scan_failed");
+    JsonArray devices = doc["devices"].to<JsonArray>();
+    for (int i = 0; i < results->getCount() && devices.size() < 8; ++i) {
+      BLEAdvertisedDevice device = results->getDevice(i);
+      if (!device.isAdvertisingService(BLEUUID(SERVICE))) continue;
+      JsonObject row = devices.add<JsonObject>();
+      row["mac"] = device.getAddress().toString();
+      row["addressType"] = device.getAddressType();
+      row["name"] = device.getName();
+      row["rssi"] = device.getRSSI();
+    }
+    scan->clearResults();
+    return serialize(doc);
+  }
+  if (sub == "connect") {
+    if (args.count() < 2 || args.count() > 3 || !validMac(args.arg(1))) return fail("connect_requires_mac_and_optional_type");
+    const int type = args.count() == 3 ? args.arg(2).toInt() : 0;
+    if (type < 0 || type > 3) return fail("invalid_address_type");
+    if (client && !cleanup()) return fail("previous_client_retirement_pending");
+    xQueueReset(frames);
+    drops.store(0); received.store(0); ++generation;
+    client = BLEDevice::createClient();
+    if (!client) return fail("client_allocation_failed");
+    client->setClientCallbacks(&callbacks);
+    if (!client->connect(BLEAddress(args.arg(1)), type, 10000)) { cleanup(); return fail("connect_failed"); }
+    connected.store(true);
+    // This wrapper can miss CONNECT before OPEN binds the connection ID.
+    // Finish service discovery before explicitly requesting MTU, so another
+    // outstanding ATT operation cannot make that request return GATT_BUSY.
+    auto* services = client->getServices();
+    if (!client->isConnected() || !services || services->empty()) { cleanup(); return fail("service_discovery_failed"); }
+    if (client->getMTU() < 230 && !client->setMTU(517)) { cleanup(); return fail("mtu_request_failed"); }
+    // setMTU only queues the request; the CFG_MTU callback owns the result.
+    const uint32_t mtuDeadline = millis() + 5000;
+    while (client->isConnected() && client->getMTU() < 230 && int32_t(mtuDeadline - millis()) > 0) delay(10);
+    if (!client->isConnected() || client->getMTU() < 230) { cleanup(); return fail("mtu_below_secure_minimum"); }
+    BLERemoteService* service = client->getService(SERVICE);
+    infoService = client->getService(BLEUUID(uint16_t(0x180a)));
+    if (service) {
+      requestChar = service->getCharacteristic(REQUEST);
+      responseChar = service->getCharacteristic(RESPONSE);
+      statusChar = service->getCharacteristic(PROBE_STATUS_UUID);
+    }
+    if (!service || !infoService || !requestChar || !responseChar || !statusChar || !requestChar->canWrite() || !responseChar->canNotify()) {
+      cleanup(); return fail("hardwareone_service_missing");
+    }
+    doc["mtu"] = client->getMTU();
+    return serialize(doc);
+  }
+  if (!client || !connected.load()) return fail("not_connected");
+  if (sub == "subscribe") {
+    if (!subscribed) {
+      const uint32_t owner = generation.load();
+      auto result = responseChar->registerForNotify([owner](BLERemoteCharacteristic*, uint8_t* data, size_t length, bool) {
+        if (owner != generation.load()) return;
+        if (!data || length > MAX_FRAME || length == 0) { ++drops; return; }
+        Frame frame;
+        frame.generation = owner;
+        frame.length = length;
+        memcpy(frame.bytes, data, length);
+        ++received;
+        if (xQueueSend(frames, &frame, 0) != pdTRUE) ++drops;
+      }, true, true, 5000);
+      if (!result.success) return fail("subscribe_failed");
+      subscribed = true;
+    }
+    return serialize(doc);
+  }
+  if (sub == "read") {
+    if (args.count() != 2) return fail("read_requires_manufacturer_model_firmware_or_status");
+    BLERemoteCharacteristic* characteristic = nullptr;
+    const String which = args.arg(1);
+    if (which == "status") characteristic = statusChar;
+    if (which == "manufacturer") characteristic = infoService->getCharacteristic(BLEUUID(uint16_t(0x2a29)));
+    if (which == "model") characteristic = infoService->getCharacteristic(BLEUUID(uint16_t(0x2a24)));
+    if (which == "firmware") characteristic = infoService->getCharacteristic(BLEUUID(uint16_t(0x2a26)));
+    if (!characteristic || !characteristic->canRead()) return fail("read_characteristic_missing");
+    String value = characteristic->readValue();
+    if (value.length() == 0 || value.length() > MAX_FRAME) return fail("read_failed_or_oversized");
+    doc["data"] = base64(reinterpret_cast<const uint8_t*>(value.c_str()), value.length());
+    return serialize(doc);
+  }
+  if (sub == "write") {
+    if (args.count() != 2 || !subscribed) return fail("write_requires_subscription_and_base64");
+    uint8_t bytes[MAX_FRAME]; size_t length = 0;
+    String encoded = args.arg(1);
+    if (mbedtls_base64_decode(bytes, sizeof(bytes), &length, reinterpret_cast<const unsigned char*>(encoded.c_str()), encoded.length()) != 0 || length == 0 || length > client->getMTU() - 3) return fail("invalid_or_oversized_record");
+    // Accept only Secure Channel client records: never forward login plaintext.
+    if (!((bytes[0] == 0x01 && length == 49) || (bytes[0] == 0x03 && length == 19) || (bytes[0] == 0x10 && length >= 25))) return fail("secure_record_required");
+    if (!requestChar->writeValue(bytes, length, true, 5000)) return fail("gatt_write_failed");
+    doc["bytes"] = length;
+    return serialize(doc);
+  }
+  if (sub == "poll") {
+    const int limit = args.count() == 2 ? args.arg(1).toInt() : 4;
+    if (limit < 1 || limit > 4 || args.count() > 2) return fail("poll_limit_1_to_4");
+    JsonArray result = doc["frames"].to<JsonArray>();
+    Frame frame;
+    for (int i = 0; i < limit && xQueueReceive(frames, &frame, 0) == pdTRUE; ++i) {
+      JsonObject row = result.add<JsonObject>();
+      row["generation"] = frame.generation;
+      row["bytes"] = frame.length;
+      row["data"] = base64(frame.bytes, frame.length);
+    }
+    return serialize(doc);
+  }
+  return fail("unknown_operation");
+}
+#else
+static const char* cmd_bleprobe(const String&) { return "{\"schema\":1,\"ok\":false,\"error\":\"bluetooth_disabled\"}"; }
+#endif
+
+const CommandEntry connectivityBleProbeCommands[] = {
+  {"bleprobe", "Isolated USB-admin board GATT test bridge.", true, cmd_bleprobe,
+   "bleprobe status|scan <1-10>|connect <mac> [type]|subscribe|read <manufacturer|model|firmware|status>|write <base64>|poll [1-4]|disconnect"}
+};
+const size_t connectivityBleProbeCommandsCount = sizeof(connectivityBleProbeCommands) / sizeof(connectivityBleProbeCommands[0]);
