+static const char* cmd_jpegdiag(const String& argsInput) {
+  RETURN_VALID_IF_VALIDATE_CSTR();
+  const AuthContext& auth = currentAuthContext();
+  String liveUser;
+  bool authenticated = false;
+  const TransportSessionEpoch epoch = serialTransportSessionSnapshot(liveUser, authenticated);
+  if (auth.transport != SOURCE_SERIAL || !authenticated || epoch == 0 ||
+      !auth.user.equalsIgnoreCase(liveUser) || !currentExecIsAdmin())
+    return "Error: jpegdiag requires a live named Serial administrator login";
+  CommandArgs args(argsInput);
+  if (args.count() != 1 || !args.argWasQuoted(0))
+    return "Error: jpegdiag requires one quoted fixture path";
+  const String path = args.arg(0);
+  if (path.length() > 191 || !path.startsWith("/jpeg_qualification/") ||
+      path.indexOf("/../") >= 0 || path.endsWith("/..") ||
+      path.indexOf("/./") >= 0 || path.indexOf('\\') >= 0)
+    return "Error: jpegdiag only accepts /jpeg_qualification/ fixture files";
+
+  constexpr uint32_t caps = MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT;
+  const size_t internalBefore = heap_caps_get_free_size(caps);
+  const size_t largestBefore = heap_caps_get_largest_free_block(caps);
+  const bool integrityBefore = heap_caps_check_integrity_all(false);
+  JpegIntegrationReport report;
+  uint8_t* bmp = nullptr;
+  size_t length = 0;
+  const char* error = nullptr;
+  const int64_t started = esp_timer_get_time();
+  const bool converted = loadJpgAsBmp288x144(path, &bmp, &length, &error, &report);
+  auto read32 = [](const uint8_t* p) -> uint32_t {
+    return uint32_t(p[0]) | (uint32_t(p[1]) << 8) | (uint32_t(p[2]) << 16) | (uint32_t(p[3]) << 24);
+  };
+  const int32_t bmpWidth = converted && length >= 118 ? int32_t(read32(bmp + 18)) : 0;
+  const int32_t bmpHeight = converted && length >= 118 ? int32_t(read32(bmp + 22)) : 0;
+  const bool bmpValid = converted && bmp && length == 118 + 144 * 144 &&
+                       bmp[0] == 'B' && bmp[1] == 'M' && bmp[28] == 4 && bmp[29] == 0 &&
+                       bmpWidth == 288 && bmpHeight == -144 && read32(bmp + 2) == length;
+  const uint32_t bmpHash = converted ? jpegIntegrationHash(bmp, length) : 0;
+  free(bmp);
+  const int64_t totalUs = esp_timer_get_time() - started;
+  const size_t internalAfter = heap_caps_get_free_size(caps);
+  const size_t largestAfter = heap_caps_get_largest_free_block(caps);
+  const bool integrityAfter = heap_caps_check_integrity_all(false);
+
+  JsonDocument doc;
+  doc["schema"] = 1;
+  doc["diagnostic"] = "full-app-jpeg";
+  doc["ok"] = converted && bmpValid && integrityBefore && integrityAfter;
+  doc["converted"] = converted;
+  doc["error"] = converted ? "" : (error ? error : "unknown");
+  doc["width"] = report.width; doc["height"] = report.height;
+  doc["backend"] = report.backend;
+  char rgbHash[9], bmpHashText[9];
+  snprintf(rgbHash, sizeof(rgbHash), "%08lx", (unsigned long)report.rgbHash);
+  snprintf(bmpHashText, sizeof(bmpHashText), "%08lx", (unsigned long)bmpHash);
+  doc["rgb_hash"] = rgbHash; doc["bmp_hash"] = bmpHashText;
+  doc["bmp_bytes"] = length; doc["bmp_valid"] = bmpValid;
+  doc["bmp_width"] = bmpWidth; doc["bmp_height"] = bmpHeight;
+  doc["decode_us"] = report.decodeUs; doc["bmp_us"] = report.bmpUs;
+  doc["total_us"] = totalUs;
+  doc["internal_before"] = internalBefore; doc["internal_after"] = internalAfter;
+  doc["largest_before"] = largestBefore; doc["largest_after"] = largestAfter;
+  doc["integrity_before"] = integrityBefore; doc["integrity_after"] = integrityAfter;
+  static char result[1024];
+  if (doc.overflowed() || measureJson(doc) >= sizeof(result))
