@@ -692,8 +692,12 @@
         }
 #endif  ///CLASSIC_BT_INCLUDED == TRUE
 #if (BLE_INCLUDED == TRUE)
+        /* HW1: cancel only this LCB's own pending connect. The global
+         * ble_connecting_bda can be stale and name an already-connected
+         * peer, whose link the cancel path would then release. */
         if (p_lcb->link_state == LST_CONNECTING &&
-                l2cb.is_ble_connecting == TRUE) {
+                l2cb.is_ble_connecting == TRUE &&
+                !memcmp(p_lcb->remote_bd_addr, l2cb.ble_connecting_bda, BD_ADDR_LEN)) {
             L2CA_CancelBleConnectReq(l2cb.ble_connecting_bda);
         }
 #endif
