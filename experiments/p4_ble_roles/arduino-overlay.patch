+#if defined(CONFIG_BLUEDROID_ENABLED)
+// Terminal-only ownership cleanup. Service constructors are private and the
+// server factory owns every service still registered in this map. Removed
+// services retain their existing lifetime contract. Callback pointers are
+// borrowed and must never be deleted here.
+void BLEServer::destroyGattTreeAfterHostDeinit() {
+  while (BLEService *service = m_serviceMap.getFirst()) {
+    // Remove both map aliases while the object/handle is still valid. Starting
+    // a fresh iteration avoids retaining an iterator invalidated by removal.
+    m_serviceMap.removeService(service);
+    service->destroyOwnedCharacteristicsAfterHostDeinit();
+    delete service;
+  }
+}
+#endif
 
