 BLECharacteristic *BLEService::createCharacteristic(BLEUUID uuid, uint32_t properties) {
   BLECharacteristic *pCharacteristic = new BLECharacteristic(uuid, properties);
+  pCharacteristic->m_ownedByService = true;
   addCharacteristic(pCharacteristic);
   return pCharacteristic;
 }  // createCharacteristic
+
+#if defined(CONFIG_BLUEDROID_ENABLED)
+void BLEService::destroyOwnedCharacteristicsAfterHostDeinit() {
+  while (BLECharacteristic *characteristic = m_characteristicMap.getFirst()) {
+    m_characteristicMap.removeCharacteristic(characteristic);
+    // addCharacteristic can attach application-owned objects. Only our factory
+    // allocations belong to the terminal server tree.
+    if (characteristic->m_ownedByService) {
+      characteristic->destroyOwnedDescriptorsAfterHostDeinit();
+      delete characteristic;
+    }
+  }
+}
+#endif
 
